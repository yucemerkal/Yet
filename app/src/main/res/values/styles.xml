<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="android:backgroundTint">#333333</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcButtonNumberWide" parent="CalcButtonNumber">
        <item name="android:layout_columnSpan">2</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="android:backgroundTint">#FF9500</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:backgroundTint">#A5A5A5</item>
        <item name="android:textColor">#000000</item>
    </style>

</resources>
